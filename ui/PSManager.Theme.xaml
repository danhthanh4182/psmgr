<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ TOKEN: COLOUR ============
       Derived from the PowerShell console navy (#012456), darkened.
       Rules: accent blue = primary action + current selection (at most one primary
       button per screen); amber = needs attention; red = destructive; green = OK
       state (dots/chips only, never as a button fill). -->
  <SolidColorBrush x:Key="BgBrush"         Color="#07101F"/>
  <SolidColorBrush x:Key="SurfaceBrush"    Color="#0D1B30"/>
  <SolidColorBrush x:Key="RaisedBrush"     Color="#14263F"/>
  <SolidColorBrush x:Key="BorderBrush"     Color="#22385A"/>
  <SolidColorBrush x:Key="TextBrush"       Color="#E8EEF8"/>
  <SolidColorBrush x:Key="TextDimBrush"    Color="#9BAECB"/>
  <SolidColorBrush x:Key="AccentBrush"     Color="#4DA3FF"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#264DA3FF"/>
  <SolidColorBrush x:Key="OnAccentBrush"   Color="#04122B"/>
  <SolidColorBrush x:Key="OkBrush"         Color="#3DD68C"/>
  <SolidColorBrush x:Key="WarnBrush"       Color="#F2B84B"/>
  <SolidColorBrush x:Key="DangerBrush"     Color="#F0605D"/>
  <SolidColorBrush x:Key="DangerLineBrush" Color="#66F0605D"/>

  <!-- ============ TOKEN: FONT ============ -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- Focus ring: only visible for keyboard (Tab) navigation -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"
                     Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ BUTTONS ============
       Btn        : secondary (hairline border, transparent fill) - default for most actions
       BtnPrimary : primary (accent fill) - one per screen
       BtnDanger  : destructive (red text/border, always paired with a confirm dialog)
       BtnRow     : action row inside a list (left aligned, no border) -->
  <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
    <Grid>
      <Border x:Name="Bd" CornerRadius="6"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"/>
      <Border x:Name="Overlay" CornerRadius="6" Background="White" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Overlay" Property="Opacity" Value="0.07"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Overlay" Property="Opacity" Value="0.14"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
  </Style>

  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DangerLineBrush}"/>
  </Style>

  <Style x:Key="BtnRow" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="12,10"/>
  </Style>

  <!-- ============ SWITCH (replaces the "Set PS7 default" / "Restore PS5" button pair) ============
       Usage: <ToggleButton Style="{DynamicResource Switch}" Content="PS7 is the default shell"/> -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" BorderThickness="1"
                    Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}">
              <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="4,0"
                       HorizontalAlignment="Left" Fill="{StaticResource TextDimBrush}"/>
            </Border>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ SEGMENTED (Source: winget | msstore | github, Channel: stable | preview | lts) ============
       Wrap the RadioButtons (same GroupName) in a Border with SurfaceBrush, CornerRadius=8, Padding=2.
       Accent is used only for the selected segment, never for an action button. -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ NAVIGATION RAIL (left shell) ============
       RadioButton per page. Checked = accent soft fill; hover = raised fill. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ TEXT & CARDS ============ -->
  <!-- Section heading: sentence case, never all caps (caps stack Vietnamese diacritics) -->
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <!-- Short description under an action name (replaces hover-only detail in the log) -->
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- Left-hand form label ("Source", "Channel", "Language") -->
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <!-- Small badge: "AES-256", "In use", "Update available"... -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
  </Style>

  <!-- Content frame: one background level, hairline border, no drop shadow -->
  <Style x:Key="Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <!-- Single-line text input (log filter) -->
  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource BgBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MaxWidth" Value="480"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Implicit default: every unstyled Button inherits Btn. Lives here because BasedOn
       cannot take a DynamicResource. -->
  <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>

</ResourceDictionary>
