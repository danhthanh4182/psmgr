        <StreamGeometry x:Key="IconTerminal">M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v10zm-2-1h-6v-2h6v2zm-9.7-3.7L5.7 12l2.6-2.3 1.4 1.4-1.2 1 1.2 1-1.4 1.2z</StreamGeometry>
