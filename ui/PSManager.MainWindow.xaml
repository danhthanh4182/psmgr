                                    <StackPanel>
                                        <TextBlock x:Name="LblHelpUpdate" Text="PSManager update" Style="{DynamicResource SectionTitle}"/>
                                        <TextBlock x:Name="TxtHelpUpdateStatus" Text="" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtHelpUpdateDetail" Text="" Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
