<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerShell Version Manager (PSManager)"
        Height="820" Width="1280" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- SVG vector geometries (crisp at any DPI, single fill) -->
        <StreamGeometry x:Key="IconZap">M13 2L3 14h9l-1 8 10-12h-9l1-8z</StreamGeometry>
