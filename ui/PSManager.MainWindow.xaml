                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock x:Name="TxtHelpQuickDefault" Text="" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TxtHelpQuickDefaultDesc" Text="" Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock x:Name="TxtHelpQuickSync" Text="" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TxtHelpQuickSyncDesc" Text="" Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="TxtHelpQuickUpdate" Text="" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TxtHelpQuickUpdateDesc" Text="" Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource Panel}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblHelpCommands" Text="Command reference" Style="{DynamicResource SectionTitle}"/>
