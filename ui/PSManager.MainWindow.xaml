                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource Panel}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblHelpLinks" Text="Project" Style="{DynamicResource SectionTitle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnOpenDocs" Style="{DynamicResource Btn}" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtBtnOpenDocs" Text="Documentation"/>
