        <!-- ================= Splitter ================= -->
        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Margin="0,4,0,4"
                      Background="Transparent" Cursor="SizeNS" FocusVisualStyle="{DynamicResource FocusRing}"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Auto" ShowsPreview="False"/>

        <!-- ================= Activity log ================= -->
        <Grid Grid.Row="3">
                <Border Style="{DynamicResource Panel}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFileText}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblLog" Text="Activity log" Style="{DynamicResource SectionTitle}" Margin="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatusHint" Text=" — Ready" FontSize="12" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <Button x:Name="BtnCancelAction" Style="{DynamicResource BtnDanger}" FontSize="12" Padding="10,2" Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Cancel"/>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Column="2" Width="150" Height="24" Margin="0,0,8,0">
                                <TextBox x:Name="TxtLogFilter" Style="{DynamicResource Input}"/>
                                <TextBlock x:Name="TxtLogFilterHint" Text="Filter log..." IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <Button x:Name="BtnLogCopy" Grid.Column="3" Style="{DynamicResource Btn}" Width="30" Height="26" Padding="0" Margin="0,0,6,0">
                                <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnLogClear" Grid.Column="4" Style="{DynamicResource Btn}" Width="30" Height="26" Padding="0" Margin="0,0,6,0">
                                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnViewLogs" Grid.Column="5" Style="{DynamicResource Btn}" Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFileText}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBtnViewLogs" Text="View Logs" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <RichTextBox x:Name="RtbConsoleLog" Grid.Row="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextDimBrush}"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                     IsReadOnly="True" IsDocumentEnabled="True"
                                     FocusVisualStyle="{DynamicResource FocusRing}"
                                     VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
                </Grid>
            </Grid>

    <!-- ================= Notification center (overlay) ================= -->
