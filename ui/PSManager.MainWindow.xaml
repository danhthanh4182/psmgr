        <StreamGeometry x:Key="IconHelp">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z</StreamGeometry>
        <StreamGeometry x:Key="IconBell">M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z</StreamGeometry>
    </Window.Resources>

    <Grid Background="{DynamicResource BgBrush}">
    <Grid MaxWidth="1200" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Body: navigation rail + page -->
            <RowDefinition Height="8"/>    <!-- Splitter -->
            <RowDefinition Height="220" MinHeight="120"/> <!-- Activity log -->
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconZap}" Fill="{DynamicResource AccentBrush}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PSManager" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <Border Style="{DynamicResource Chip}" Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVersion" Text="v—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TxtSubtitle" Text="PowerShell Version Manager &amp; Control Center" FontSize="13" Foreground="{DynamicResource TextDimBrush}" Margin="30,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnHelp" Style="{DynamicResource Btn}" Width="34" Height="32" Padding="0" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconHelp}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnNotifications" Style="{DynamicResource Btn}" Width="38" Height="32" Padding="0" Margin="0,0,8,0">
                    <Grid>
                        <Path Data="{StaticResource IconBell}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="NotifBadge" Background="{DynamicResource DangerBrush}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtNotifBadge" Text="0" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="BtnRefresh" Style="{DynamicResource Btn}" Width="34" Height="32" Padding="0" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnLangToggle" Style="{DynamicResource Btn}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconGlobe}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLangToggle" Text="English" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnLaunchTUI" Style="{DynamicResource Btn}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTerminal}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtBtnLaunchTUI" Text="Open TUI Console" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ProgressBar x:Name="PrgBusy" Grid.Row="1" Grid.ColumnSpan="2" Height="3" IsIndeterminate="True"
                         Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"
                         Visibility="Collapsed" Margin="0,8,0,0"/>
        </Grid>

        <!-- ================= Body: navigation rail + page ================= -->
        <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation rail -->
                <Border Grid.Column="0" Style="{DynamicResource Panel}" Padding="8" Margin="0,0,12,0" VerticalAlignment="Top">
                    <StackPanel>
                        <RadioButton x:Name="NavOverview" AutomationProperties.Name="{Binding Text, ElementName=TxtNavOverview}" Style="{DynamicResource NavItem}" GroupName="Nav" Tag="overview" IsChecked="True" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMonitor}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavOverview" Text="Overview"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUpdate" AutomationProperties.Name="{Binding Text, ElementName=TxtNavUpdate}" Style="{DynamicResource NavItem}" GroupName="Nav" Tag="update" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUpdate}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavUpdate" Text="Update"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBackup" AutomationProperties.Name="{Binding Text, ElementName=TxtNavBackup}" Style="{DynamicResource NavItem}" GroupName="Nav" Tag="backup" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconArchive}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavBackup" Text="Backup"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavHealth" AutomationProperties.Name="{Binding Text, ElementName=TxtNavHealth}" Style="{DynamicResource NavItem}" GroupName="Nav" Tag="health" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHealth}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavHealth" Text="Health"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavProfile" AutomationProperties.Name="{Binding Text, ElementName=TxtNavProfile}" Style="{DynamicResource NavItem}" GroupName="Nav" Tag="profile">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFileText}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavProfile" Text="Profiles"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavHelp" AutomationProperties.Name="{Binding Text, ElementName=TxtNavHelp}" Style="{DynamicResource NavItem}" GroupName="Nav" Tag="help" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHelp}" Fill="{DynamicResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavHelp" Text="Help"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Page host: one page visible at a time -->
                <Grid Grid.Column="1">
                    <!-- ===== Overview ===== -->
                    <Grid x:Name="PageOverview" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel>
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <Border Style="{DynamicResource Panel}" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconTerminal}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LblCardDefault" Text="Default shell" Style="{DynamicResource Caption}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CardWTDefault" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="CardWTSub" Text="" Style="{DynamicResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource Panel}" Padding="14" Margin="4,0,4,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconMonitor}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LblCardHost" Text="Terminal host" Style="{DynamicResource Caption}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CardHost" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="CardHostSub" Text="" Style="{DynamicResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource Panel}" Padding="14" Margin="4,0,4,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconLink}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LblCardShim" Text="Command shim" Style="{DynamicResource Caption}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CardShim" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="CardShimSub" Text="" Style="{DynamicResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource Panel}" Padding="14" Margin="8,0,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconPackage}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LblCardSource" Text="Update source" Style="{DynamicResource Caption}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CardSource" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="CardSourceSub" Text="" Style="{DynamicResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{DynamicResource Panel}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblSecDefault" Text="Default shell" Style="{DynamicResource SectionTitle}"/>
                                        <Button x:Name="BtnSetDefaultPS7" Style="{DynamicResource BtnPrimary}" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconStar}" Fill="{DynamicResource OnAccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtBtnSetDefaultPS7" Text="Set PS7 as Default" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="TxtCapDefaultPS7" Text="" Style="{DynamicResource Caption}" Margin="2,0,0,10"/>
                                        <Button x:Name="BtnRestorePS5" Style="{DynamicResource Btn}" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconUndo}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtBtnRestorePS5" Text="Revert to PS5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="TxtCapRestorePS5" Text="" Style="{DynamicResource Caption}" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource Panel}" Padding="16">
                                    <StackPanel>
                                        <TextBlock x:Name="LblQuickLaunch" Text="Quick launch" Style="{DynamicResource SectionTitle}"/>
                                        <UniformGrid Columns="2">
                                            <Button x:Name="BtnLaunchPS7" Style="{DynamicResource Btn}" Margin="0,0,4,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource OkBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtBtnLaunchPS7" Text="Launch PS7" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnLaunchPS7Admin" Style="{DynamicResource Btn}" Margin="4,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
