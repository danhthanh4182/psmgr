            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtNotifTitle" Text="Notifications" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                <Button x:Name="BtnNotifClear" Grid.Column="1" Style="{DynamicResource Btn}" FontSize="12" Padding="10,2" Margin="0,0,6,0">
                    <TextBlock Text="Clear all"/>
                </Button>
                <Button x:Name="BtnNotifClose" Grid.Column="2" Style="{DynamicResource Btn}" Width="30" Height="26" Padding="0">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420" Margin="0,10,0,0">
                <StackPanel x:Name="NotifList"/>
            </ScrollViewer>
            <TextBlock x:Name="TxtNotifEmpty" Grid.Row="2" Text="No notifications yet." Style="{DynamicResource Caption}" Visibility="Collapsed" Margin="0,8,0,0"/>
        </Grid>
    </Border>

    <!-- ================= In-app toast (overlay) ================= -->
    <Border x:Name="ToastPanel" Panel.ZIndex="21" Width="360" Visibility="Collapsed"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
            Style="{DynamicResource Panel}" Padding="14">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtToastTitle" Text="" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="BtnToastClose" Grid.Column="1" Style="{DynamicResource Btn}" Width="30" Height="26" Padding="0" Margin="8,0,0,0">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>
            <TextBlock x:Name="TxtToastMessage" Text="" Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
    </Grid>
</Window>
