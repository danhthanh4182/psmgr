                            <StackPanel>
                                <Border Style="{DynamicResource Panel}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtHelpTitle" Text="Help &amp; About" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="TxtHelpSubtitle" Text="" Style="{DynamicResource Caption}" Margin="0,2,0,10"/>
                                        <Border Style="{DynamicResource Chip}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock x:Name="TxtHelpVersion" Text="v-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock x:Name="TxtHelpIntro" Text="" Style="{DynamicResource Caption}" Margin="0,0,0,12"/>
