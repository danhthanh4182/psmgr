                                                    <Path Data="{StaticResource IconDownload}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtBtnInstallUpdate" Text="Install update" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnOpenRelease" Style="{DynamicResource Btn}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconLink}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtBtnOpenRelease" Text="View release" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtCapCheckUpdate" Text="" Style="{DynamicResource Caption}" Margin="2,8,0,0"/>
                                    </StackPanel>
